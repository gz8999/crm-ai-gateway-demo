# Never commit real API keys.
# Keep AI_PROVIDER=demo unless explicitly testing external LLM.
AI_PROVIDER=demo
ALLOW_EXTERNAL_AI=false
CRM_WRITEBACK_ENABLED=false
FEATURE_DEEP_ANALYSIS=true
VITE_FEATURE_DEEP_ANALYSIS=true
DEEP_ANALYSIS_EXTERNAL_ENABLED=false
DEEP_ANALYSIS_DEFAULT_PROVIDER=demo
DEEP_ANALYSIS_HIGH_FIDELITY_ENABLED=false
# High-fidelity analysis must use the full JSON output contract. Reference-only is probe-only.
DEEP_ANALYSIS_HIGH_FIDELITY_TRANSPORT=json
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_TOKENS=1200
LLM_DEEP_ANALYSIS_MAX_TOKENS=2400
LLM_TEMPERATURE=0.2
LLM_AUDIT_LOG=true
